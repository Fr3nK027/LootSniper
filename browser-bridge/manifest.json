{
  "manifest_version": 3,
  "name": "LootSniper Bridge",
  "version": "1.4.0",
  "description": "Importa e aggiorna gli annunci visibili su Vinted, eBay e Subito in LootSniper.",
  "permissions": ["activeTab", "alarms", "storage"],
  "host_permissions": [
    "https://*.ebay.it/*",
    "https://*.ebay.com/*",
    "https://*.subito.it/*",
    "https://*.vinted.it/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LootSniper: importa questa pagina",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.it/*",
        "https://*.ebay.com/*",
        "https://*.subito.it/*",
        "https://*.vinted.it/*",
        "http://127.0.0.1:8765/*"
      ],
      "js": ["listings.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
